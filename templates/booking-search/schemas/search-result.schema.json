{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hotel Search Result",
  "description": "Normalized result of one hotel search from the granted provider skill. Null fields are presented as 'not listed'.",
  "type": "object",
  "required": ["query", "destination", "total_count", "hotels"],
  "properties": {
    "query": {
      "type": "object",
      "required": ["location", "checkin", "checkout", "adults", "children", "rooms"],
      "properties": {
        "location": { "type": "string" },
        "checkin": { "type": "string", "format": "date" },
        "checkout": { "type": "string", "format": "date" },
        "adults": { "type": "integer", "minimum": 1 },
        "children": { "type": "integer", "minimum": 0 },
        "childrenAges": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 17 } },
        "rooms": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "destination": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "description": "city, region, landmark, hotel, airport, ..." },
        "label": { "type": "string", "description": "Shown back to the user to confirm the match" }
      }
    },
    "total_count": { "type": "integer", "minimum": 0 },
    "hotels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "address": { "type": ["string", "null"] },
          "distance": { "type": ["string", "null"] },
          "review_score": { "type": ["number", "null"] },
          "review_score_label": { "type": ["string", "null"] },
          "review_count": { "type": ["integer", "null"] },
          "price_display": { "type": ["string", "null"] },
          "price_original": { "type": ["string", "null"] },
          "nights_and_guests": { "type": ["string", "null"] },
          "image": { "type": ["string", "null"] },
          "rooms": { "type": ["string", "null"] },
          "free_cancellation": { "type": ["boolean", "null"] },
          "breakfast_included": { "type": ["boolean", "null"] }
        }
      }
    }
  }
}
