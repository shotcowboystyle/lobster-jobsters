# Booking Search Agent — Environment Variables
# Names only. Put values in your secrets manager or a .env outside the repo. NEVER commit .env.

# === Search provider (official/affiliate API whose terms permit automated queries) ===
HOTEL_SEARCH_API_KEY=your_hotel_search_provider_api_key

# === Discord (only if answering in Discord) ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_TRAVEL=channel_id_for_travel
DISCORD_CHANNEL_ALERTS=channel_id_for_search_alerts

# === Ledger ===
BOOKING_SEARCH_LEDGER_DB_PATH=/path/to/workspaces/booking-search/data/booking-search-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workspaces/booking-search/config/emergency-stop.json

# === Timezone (for relative-date parsing) ===
TZ=America/New_York
