# Client Reporting Agent — Environment Variables
# Names only. Put values in your secrets manager or a .env outside the repo. NEVER commit .env.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_ALERTS=channel_id_for_reporting_alerts
# AM channels are listed per client in USER.md

# === Per-client credentials (repeat per client; slug uppercased, hyphens -> underscores) ===
CLIENT_CLIENT_A_GA4_SERVICE_ACCOUNT_JSON=/path/to/secret/client-a-ga4.json
CLIENT_CLIENT_A_GSC_SERVICE_ACCOUNT_JSON=/path/to/secret/client-a-gsc.json
CLIENT_CLIENT_A_GOOGLE_ADS_REFRESH_TOKEN=your_client_a_google_ads_refresh_token
CLIENT_CLIENT_A_META_ADS_TOKEN=
CLIENT_CLIENT_A_TRACKER_TOKEN=your_client_a_tracker_token

CLIENT_CLIENT_B_GA4_SERVICE_ACCOUNT_JSON=/path/to/secret/client-b-ga4.json
CLIENT_CLIENT_B_GSC_SERVICE_ACCOUNT_JSON=/path/to/secret/client-b-gsc.json

# === Ledger ===
CLIENT_REPORTING_LEDGER_DB_PATH=/path/to/workspaces/client-reporting/data/client-reporting-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workspaces/client-reporting/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
