# SEO Content Planner — Environment Variables
# Names only. Put values in your secrets manager or a .env outside the repo. NEVER commit .env.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_BRIEFINGS=channel_id_for_seo_briefings
DISCORD_CHANNEL_DRAFTS=channel_id_for_seo_drafts
DISCORD_CHANNEL_ALERTS=channel_id_for_seo_alerts

# === Data sources (read-only) ===
GSC_SERVICE_ACCOUNT_JSON=/path/to/secret/gsc.json
GA4_SERVICE_ACCOUNT_JSON=/path/to/secret/ga4.json

# === Content calendar (shared with the calendar database only) ===
NOTION_TOKEN=your_notion_integration_token

# === Ledger ===
SEO_CONTENT_PLANNER_LEDGER_DB_PATH=/path/to/workspaces/seo-content-planner/data/seo-content-planner-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workspaces/seo-content-planner/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
