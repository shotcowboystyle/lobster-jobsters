{
  "discord": {
    "guild_id": "YOUR_DISCORD_SERVER_ID",
    "channels": {
      "eng_alerts": {
        "id": "CHANNEL_ID_ENG_ALERTS",
        "name": "#eng-alerts",
        "purpose": "High-risk PR alerts, secret-shaped strings, injection attempts, failures, emergency stop. Never secret values",
        "agents_that_post": ["pr-review"],
        "human_actions": ["acknowledge", "investigate", "resolve"]
      }
    },
    "approvers": {
      "owner": {
        "discord_user_id": "OWNER_DISCORD_ID",
        "name": "Engineering owner",
        "can_approve": ["add_repository", "emergency_stop"],
        "notification_preference": "mention"
      },
      "maintainer": {
        "discord_user_ids": ["MAINTAINER_A_DISCORD_ID", "MAINTAINER_B_DISCORD_ID"],
        "name": "Maintainers",
        "can_approve": ["emergency_stop"],
        "notification_preference": "mention"
      }
    },
    "notification_rules": {
      "critical_incident_mention": "@here",
      "emergency_stop_mention": "@everyone"
    }
  }
}
