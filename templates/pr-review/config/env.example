# PR Review Agent — Environment Variables
# Names only. Put values in your secrets manager or a .env outside the repo. NEVER commit .env.

# === GitHub (App installation token; never a personal access token) ===
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_INSTALLATION_ID=your_installation_id
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/secret/github-app.pem
GITHUB_APP_INSTALLATION_TOKEN=minted_at_runtime_from_the_app_key
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_HIGH_RISK=channel_id_for_eng_alerts

# === Ledger ===
PR_REVIEW_LEDGER_DB_PATH=/path/to/workspaces/pr-review/data/pr-review-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workspaces/pr-review/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
