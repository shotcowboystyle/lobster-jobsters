# {{COMPANY}} {{TEAM_NAME}} Team ({{PERSONA}}) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_{{TEAM_SLUG}}_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_{{TEAM_SLUG}}_approvals
DISCORD_CHANNEL_ALERTS=channel_id_for_{{TEAM_SLUG}}_alerts

# === Ledger ===
{{TEAM_SLUG}}_LEDGER_DB_PATH=/path/to/workforce/agents/{{TEAM_SLUG}}/data/{{TEAM_SLUG}}-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/{{TEAM_SLUG}}/config/emergency-stop.json
SHARED_EMERGENCY_STOP_FILE=/path/to/workforce/config/shared-emergency-stop.json

# === Agent runtime ===
AGENT_WORKSPACE_DIR=/path/to/workforce/agents/{{TEAM_SLUG}}
AGENT_ID={{CHANNEL_PREFIX}}-{{TEAM_SLUG}}-{{PERSONA}}

# === Timezone ===
TZ=America/New_York
