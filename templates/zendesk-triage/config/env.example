# Zendesk Triage Agent — Environment Variables
# Names only. Put values in your secrets manager or a .env outside the repo. NEVER commit .env.

# === Zendesk (service user with the restricted role in TOOLS.md) ===
ZENDESK_SUBDOMAIN=your_subdomain
ZENDESK_SERVICE_USER_EMAIL=triage-bot@support.example
ZENDESK_API_TOKEN=your_zendesk_api_token

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_SUPPORT_LEADS=channel_id_for_support_leads
DISCORD_CHANNEL_ALERTS=channel_id_for_triage_alerts

# === Ledger ===
ZENDESK_TRIAGE_LEDGER_DB_PATH=/path/to/workspaces/zendesk-triage/data/zendesk-triage-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workspaces/zendesk-triage/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
