# Stripe Revenue Reporter — Environment Variables
# Names only. Put values in your secrets manager or a .env outside the repo. NEVER commit .env.

# === Stripe (restricted key, READ-ONLY scopes only) ===
STRIPE_RESTRICTED_KEY=your_restricted_read_only_key

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DIGEST=channel_id_for_revenue_digest
DISCORD_CHANNEL_ALERTS=channel_id_for_revenue_alerts

# === Ledger ===
STRIPE_REVENUE_REPORTER_LEDGER_DB_PATH=/path/to/workspaces/stripe-revenue-reporter/data/stripe-revenue-reporter-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workspaces/stripe-revenue-reporter/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
