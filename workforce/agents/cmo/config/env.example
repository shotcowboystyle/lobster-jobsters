# ACME Bonsai Social Marketing Team — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_social_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_social_approvals
DISCORD_CHANNEL_ENGAGEMENT=channel_id_for_social_engagement
DISCORD_CHANNEL_REPORTS=channel_id_for_social_reports

# === Meta / Facebook ===
META_PAGE_ID=your_facebook_page_id
META_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# === Meta / Instagram ===
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
# Instagram uses the same page access token as Facebook

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/cmo
CLAUDE_AGENT_ID=acme-social

# === Database ===
POST_LEDGER_DB_PATH=/path/to/workforce/data/post-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
