{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostBrief",
  "description": "Per-post brief generated by Content Brief agent",
  "type": "object",
  "required": ["post_id", "platform", "vertical", "scheduled_date", "theme", "key_messages", "visual_direction", "cta_direction", "tone_reminder", "status"],
  "properties": {
    "post_id": {
      "type": "string",
      "pattern": "^acme-\\d{4}-\\d{2}-\\d{2}-(ig|fb)-(wholesale|local|display|events)-\\d{3}$",
      "description": "Unique post ID: acme-YYYY-MM-DD-{platform}-{vertical}-{seq}"
    },
    "campaign_id": { "type": "string" },
    "platform": { "type": "string", "enum": ["instagram", "facebook"] },
    "vertical": { "type": "string", "enum": ["wholesale", "local", "display", "events"] },
    "scheduled_date": { "type": "string", "format": "date" },
    "theme": { "type": "string", "minLength": 10 },
    "key_messages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "maxItems": 5
    },
    "visual_direction": { "type": "string" },
    "cta_direction": { "type": "string" },
    "hashtag_suggestions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "placeholders": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of [PLACEHOLDER] items needing human input"
    },
    "tone_reminder": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["planned", "drafted"]
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
