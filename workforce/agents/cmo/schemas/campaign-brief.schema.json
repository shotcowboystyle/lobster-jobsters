{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignBrief",
  "description": "Weekly campaign brief generated by Strategy Planner",
  "type": "object",
  "required": ["campaign_id", "week_start", "week_end", "created_at", "status", "items"],
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^acme-campaign-\\d{4}-W\\d{2}$",
      "description": "Unique campaign ID: acme-campaign-YYYY-WNN"
    },
    "week_start": { "type": "string", "format": "date" },
    "week_end": { "type": "string", "format": "date" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["draft", "awaiting_approval", "approved", "rejected"]
    },
    "notes": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "platform", "vertical", "theme"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "platform": { "type": "string", "enum": ["instagram", "facebook"] },
          "vertical": { "type": "string", "enum": ["wholesale", "local", "display", "events"] },
          "theme": { "type": "string", "minLength": 10 },
          "asset_needs": { "type": "string", "enum": ["new_photo", "existing_asset", "graphic", "video", "carousel", "tbd"] },
          "priority": { "type": "string", "enum": ["standard", "high", "low"] },
          "notes": { "type": "string" }
        }
      },
      "minItems": 1
    }
  }
}
