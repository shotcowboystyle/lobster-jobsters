# ACME Bonsai Contract Coordinator Team — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_contracts_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_contracts_approvals
DISCORD_CHANNEL_DELIVERY=channel_id_for_contracts_delivery
DISCORD_CHANNEL_ALERTS=channel_id_for_contracts_alerts

# === DocuSign ===
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key
DOCUSIGN_USER_ID=your_docusign_user_id
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_PRIVATE_KEY_PATH=/path/to/docusign_private_key.pem
DOCUSIGN_BASE_URL=https://www.docusign.net/restapi
DOCUSIGN_TEMPLATE_ID_WHOLESALE=template_id_for_wholesale_purchase_agreement

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_ACH_ENABLED=true

# === Google Maps ===
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Required APIs: Directions API, Geocoding API

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/contract-coordinator
CLAUDE_AGENT_ID=acme-contract-coordinator

# === Database ===
CONTRACT_LEDGER_DB_PATH=/path/to/workforce/agents/contract-coordinator/data/contract-ledger.db

# === Inventory ===
# Path or Google Sheets ID for the canonical tree inventory sheet
INVENTORY_SHEET_ID=your_google_sheet_id_for_inventory

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/contract-coordinator/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
