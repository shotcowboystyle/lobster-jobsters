{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContractRequest",
  "description": "Qualified buyer request used as the input to Sage's contract-generation step",
  "type": "object",
  "required": ["contract_id", "buyer", "line_items", "delivery_window", "total_usd", "deposit_pct", "qualified_by", "qualified_at"],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^acme-c-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$",
      "description": "Format: acme-c-YYYY-MM-DD-{buyer-slug}"
    },
    "buyer": {
      "type": "object",
      "required": ["legal_name", "billing_email", "shipping_address"],
      "properties": {
        "legal_name": { "type": "string" },
        "dba": { "type": "string" },
        "primary_contact": { "type": "string" },
        "billing_email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "billing_address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string", "minLength": 2, "maxLength": 2 },
            "zip": { "type": "string" }
          }
        },
        "shipping_address": {
          "type": "object",
          "required": ["street", "city", "state", "zip"],
          "properties": {
            "street": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string", "minLength": 2, "maxLength": 2 },
            "zip": { "type": "string" }
          }
        },
        "tax_exempt": { "type": "boolean", "default": false },
        "tax_exempt_cert_id": { "type": "string" }
      }
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["species", "size", "quantity", "unit_price_usd"],
        "properties": {
          "species": { "type": "string" },
          "size": {
            "type": "string",
            "description": "e.g. '4in', '6in', 'specimen-24in'"
          },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit_price_usd": { "type": "number", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "delivery_window": {
      "type": "object",
      "required": ["earliest", "latest"],
      "properties": {
        "earliest": { "type": "string", "format": "date" },
        "latest": { "type": "string", "format": "date" }
      }
    },
    "total_usd": { "type": "number", "minimum": 0 },
    "deposit_pct": { "type": "number", "minimum": 0.5, "maximum": 1.0, "default": 0.5 },
    "deposit_method": { "type": "string", "enum": ["stripe", "ach"], "default": "stripe" },
    "qualified_by": { "type": "string", "description": "Agent or operator who qualified this inquiry" },
    "qualified_at": { "type": "string", "format": "date-time" },
    "high_risk_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Items from README's High-Risk Content Detection Checklist that apply"
    },
    "ceo_escalation_required": {
      "type": "boolean",
      "description": "True if total_usd > 5000 or any high_risk_flags are set"
    }
  }
}
