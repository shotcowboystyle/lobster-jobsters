{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InventoryReservation",
  "description": "Inventory hold placed by Grove the moment a deposit clears",
  "type": "object",
  "required": ["reservation_id", "contract_id", "line_items", "status", "reserved_at", "hold_until"],
  "properties": {
    "reservation_id": {
      "type": "string",
      "pattern": "^acme-r-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$",
      "description": "Format: acme-r-YYYY-MM-DD-{slug}"
    },
    "contract_id": { "type": "string", "pattern": "^acme-c-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["species", "size", "quantity_requested", "quantity_reserved"],
        "properties": {
          "species": { "type": "string" },
          "size": { "type": "string" },
          "quantity_requested": { "type": "integer", "minimum": 1 },
          "quantity_reserved": { "type": "integer", "minimum": 0 },
          "short_quantity": { "type": "integer", "minimum": 0 },
          "substitute_offered": {
            "type": "object",
            "properties": {
              "species": { "type": "string" },
              "size": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 0 }
            }
          },
          "row_in_inventory_sheet": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["reserved", "partial_reserved", "short", "released", "fulfilled"]
    },
    "reserved_at": { "type": "string", "format": "date-time" },
    "hold_until": { "type": "string", "format": "date-time", "description": "Reservation expires at this time unless extended" },
    "released_at": { "type": "string", "format": "date-time" },
    "release_reason": { "type": "string" },
    "fulfilled_at": { "type": "string", "format": "date-time" },
    "idempotency_key": {
      "type": "string",
      "pattern": "^acme-.+-reserve-\\d+$",
      "description": "Format: acme-{contract_id}-reserve-{attempt}"
    },
    "safety_threshold_flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Species/size combos that crossed safety threshold due to this reservation"
    }
  }
}
