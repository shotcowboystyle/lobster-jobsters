{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VarianceReport",
  "description": "Budget-to-actual variance report owned by Horizon",
  "type": "object",
  "required": ["variance_id", "period", "lines", "status", "drafted_at"],
  "properties": {
    "variance_id": {
      "type": "string",
      "pattern": "^acme-fin-var-\\d{4}-\\d{2}$"
    },
    "period": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
    "kind": {
      "type": "string",
      "enum": ["monthly", "quarterly", "ytd"],
      "default": "monthly"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["line_item", "actual_usd", "budget_usd", "variance_usd", "variance_pct"],
        "properties": {
          "line_item": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["revenue", "cogs", "opex", "headcount", "marketing", "ops", "other"]
          },
          "actual_usd": { "type": "number" },
          "budget_usd": { "type": "number" },
          "variance_usd": { "type": "number" },
          "variance_pct": { "type": "number" },
          "material": { "type": "boolean", "description": "True if abs(variance_pct) > 15" },
          "owner": { "type": "string" },
          "explanation": { "type": "string" },
          "corrective_action": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "≤200-word narrative of the variance story for the period"
    },
    "status": {
      "type": "string",
      "enum": ["drafted", "cfo_review", "published", "archived"]
    },
    "drafted_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
