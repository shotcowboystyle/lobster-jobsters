{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MonthlyClose",
  "description": "Monthly close package owned by Ledger and approved by Sterling + Jane",
  "type": "object",
  "required": ["close_id", "period", "status", "opened_at", "tasks"],
  "properties": {
    "close_id": {
      "type": "string",
      "pattern": "^acme-fin-cls-\\d{4}-\\d{2}$",
      "description": "Format: acme-fin-cls-YYYY-MM"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$",
      "description": "Period being closed (YYYY-MM)"
    },
    "status": {
      "type": "string",
      "enum": ["opened", "reconciling", "variance_review", "cfo_review", "ceo_review", "closed", "held", "archived"]
    },
    "opened_at": { "type": "string", "format": "date-time" },
    "target_close_at": { "type": "string", "format": "date-time", "description": "Day 5 of following month, 6 PM ET" },
    "actual_close_at": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task", "owner", "status"],
        "properties": {
          "task": { "type": "string" },
          "owner": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "in_progress", "blocked", "done"] },
          "blocker": { "type": "string" }
        }
      }
    },
    "reconciliations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account": { "type": "string" },
          "status": { "type": "string", "enum": ["clean", "variance_documented", "unresolved"] },
          "variance_usd": { "type": "number" },
          "variance_explanation": { "type": "string" }
        }
      }
    },
    "material_variances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_item": { "type": "string" },
          "actual_usd": { "type": "number" },
          "expected_usd": { "type": "number" },
          "variance_pct": { "type": "number" },
          "owner": { "type": "string" },
          "explanation": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "One-page CFO summary attached to the package",
      "properties": {
        "headline": { "type": "string" },
        "cash_position_usd": { "type": "number" },
        "revenue_usd": { "type": "number" },
        "gross_margin_pct": { "type": "number" },
        "net_income_usd": { "type": "number" },
        "runway_days": { "type": "integer" },
        "key_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
