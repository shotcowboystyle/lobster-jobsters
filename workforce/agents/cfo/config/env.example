# ACME Bonsai CFO Team (Sterling) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_finance_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_finance_approvals
DISCORD_CHANNEL_REPORTS=channel_id_for_finance_reports
DISCORD_CHANNEL_ALERTS=channel_id_for_finance_alerts

# === Accounting System ===
ACCOUNTING_PROVIDER=quickbooks   # or "xero"
ACCOUNTING_API_KEY=your_accounting_api_key
ACCOUNTING_REALM_ID=your_company_realm_id

# === Banking ===
BANKING_PROVIDER=plaid           # or "direct" for bank API
BANKING_API_KEY=your_banking_api_key
BANKING_ACCOUNT_IDS=acct_id_1,acct_id_2

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# === Tax / Filing Service ===
TAX_SERVICE_PROVIDER=avalara     # or "taxjar"
TAX_SERVICE_API_KEY=your_tax_service_api_key

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/cfo
CLAUDE_AGENT_ID=acme-cfo-sterling

# === Database ===
FINANCE_LEDGER_DB_PATH=/path/to/workforce/agents/cfo/data/finance-ledger.db

# === Cross-team ledger root (Horizon read-only) ===
WORKSPACE_ROOT=/path/to/workforce/agents

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/cfo/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
