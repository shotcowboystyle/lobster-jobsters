# ACME Bonsai COO Team (Victor) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_ops_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_ops_approvals
DISCORD_CHANNEL_FULFILLMENT=channel_id_for_ops_fulfillment
DISCORD_CHANNEL_ALERTS=channel_id_for_ops_alerts

# === Google Sheets (Inventory) ===
INVENTORY_SHEET_ID=your_google_sheet_id_for_inventory
GOOGLE_SHEETS_SERVICE_ACCOUNT_KEY_PATH=/path/to/service_account.json

# === Google Calendar (Workshops, read-only) ===
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_CALENDAR_WORKSHOP_ID=workshops@acme-bonsai.example

# === Google Maps Platform ===
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# Required APIs: Directions API, Geocoding API

# === Environmental Sensors ===
SENSOR_API_KEY=your_sensor_api_key
SENSOR_DEVICE_IDS=greenhouse_1,greenhouse_2,workshop_room,outdoor_north

# === Email + SMS Providers ===
EMAIL_PROVIDER=postmark   # or "ses" or "resend"
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key
EMAIL_FROM_ADDRESS=ops@acme-bonsai.example

SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=your_sms_provider_api_key
SMS_FROM_NUMBER=+18435551234

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/coo
CLAUDE_AGENT_ID=acme-coo-victor

# === Database ===
OPS_LEDGER_DB_PATH=/path/to/workforce/agents/coo/data/ops-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/coo/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
