# ACME Bonsai Creative Director Team (Masahiko) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_creative_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_creative_approvals
DISCORD_CHANNEL_LIBRARY=channel_id_for_creative_library
DISCORD_CHANNEL_ALERTS=channel_id_for_creative_alerts

# === Figma ===
FIGMA_API_KEY=your_figma_personal_access_token
FIGMA_TEAM_ID=your_figma_team_id

# === Asset Storage (S3 / Dropbox / Drive) ===
ASSET_STORAGE_PROVIDER=s3   # or "dropbox" or "gdrive"
ASSET_STORAGE_API_KEY=your_storage_api_key
ASSET_STORAGE_BUCKET=acme-creative
ASSET_LIBRARY_BASE_URL=https://assets.acme-bonsai.example

# === Brand System ===
BRAND_SYSTEM_PATH=/path/to/workforce/agents/creative-director/data/brand-system

# === Email Provider (photo releases) ===
EMAIL_PROVIDER=postmark
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key
EMAIL_FROM_ADDRESS=creative@acme-bonsai.example

# === DocuSign (photo release agreements) ===
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key
DOCUSIGN_USER_ID=your_docusign_user_id
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_PRIVATE_KEY_PATH=/path/to/docusign_private_key.pem
DOCUSIGN_TEMPLATE_ID_PHOTO_RELEASE=template_id_for_photo_release

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/creative-director
CLAUDE_AGENT_ID=acme-creative-director-masahiko

# === Database ===
CREATIVE_LEDGER_DB_PATH=/path/to/workforce/agents/creative-director/data/creative-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/creative-director/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
