{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreativeBrief",
  "description": "Creative work request — intake and triage owned by Masahiko",
  "type": "object",
  "required": ["brief_id", "title", "requester", "requester_team", "purpose", "kind", "deadline", "submitted_at", "status"],
  "properties": {
    "brief_id": {
      "type": "string",
      "pattern": "^acme-creative-br-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
    },
    "title": { "type": "string", "maxLength": 120 },
    "requester": { "type": "string" },
    "requester_team": {
      "type": "string",
      "enum": ["cmo", "director-of-sales", "coo", "cfo", "cto", "customer-service-manager", "contract-coordinator", "ceo", "chief-of-staff"]
    },
    "purpose": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": ["brand_asset", "photography", "care_guide", "presentation", "campaign_creative", "signage", "packaging", "template", "other"]
    },
    "audience": { "type": "string" },
    "specs": {
      "type": "object",
      "properties": {
        "dimensions": { "type": "string", "description": "e.g. '1080×1080', '16:9 widescreen', 'A4 portrait'" },
        "formats": { "type": "array", "items": { "type": "string" }, "description": "e.g. ['PNG', 'SVG', 'PDF']" },
        "color_constraints": { "type": "string" },
        "typography_constraints": { "type": "string" },
        "copy": { "type": "string", "description": "Provided copy from requester" }
      }
    },
    "deadline": { "type": "string", "format": "date" },
    "estimated_hours": { "type": "number", "minimum": 0 },
    "estimated_cost_usd": { "type": "number", "minimum": 0 },
    "approval_path": {
      "type": "string",
      "enum": ["cd_only", "cd_plus_ceo"],
      "description": "cd_only for ≤$2K; cd_plus_ceo for >$2K"
    },
    "assigned_to": {
      "type": "string",
      "enum": ["hana", "iris", "mira", "external"]
    },
    "linked_deliverable_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "submitted_at": { "type": "string", "format": "date-time" },
    "triaged_at": { "type": "string", "format": "date-time" },
    "triaged_by": { "type": "string" },
    "assigned_at": { "type": "string", "format": "date-time" },
    "delivered_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["intake", "triaged", "assigned", "in_production", "in_review", "approved", "delivered", "rejected", "revising", "archived"]
    },
    "rejected_reason": { "type": "string" }
  }
}
