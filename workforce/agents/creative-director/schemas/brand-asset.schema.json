{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrandAsset",
  "description": "Final delivered asset in the brand asset library — owned by Hana for cataloging; Masahiko approves entry",
  "type": "object",
  "required": ["asset_id", "kind", "title", "file_paths", "created_at", "status"],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^acme-creative-as-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$"
    },
    "source_deliverable_id": { "type": "string" },
    "source_shoot_id": { "type": "string" },
    "source_guide_id": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "logo_variant", "social_graphic", "email_template", "ad_creative",
        "presentation_template", "product_photo", "lifestyle_photo",
        "event_photo", "infographic", "care_guide_pdf", "signage",
        "packaging", "icon", "pattern", "video", "audio", "other"
      ]
    },
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "subject_tree_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^acme-tr-[a-z0-9-]+$" },
      "description": "If asset features specific trees from inventory"
    },
    "file_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["format", "url_or_path"],
        "properties": {
          "format": { "type": "string", "description": "PNG, SVG, PDF, JPG, MP4, etc." },
          "url_or_path": { "type": "string" },
          "purpose": { "type": "string", "description": "web, print, social, thumbnail" },
          "dimensions": { "type": "string" },
          "file_size_kb": { "type": "number" }
        }
      }
    },
    "version": { "type": "string", "description": "Semantic version, e.g. '1.0.0'" },
    "previous_versions": {
      "type": "array",
      "items": { "type": "string", "description": "Previous asset_ids if this supersedes them" }
    },
    "approval": {
      "type": "object",
      "properties": {
        "approved_by": { "type": "string", "default": "masahiko" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "release_status": {
      "type": "object",
      "description": "For assets featuring customer property / faces",
      "properties": {
        "release_required": { "type": "boolean", "default": false },
        "release_signed": { "type": "boolean", "default": false },
        "release_docusign_envelope_id": { "type": "string" },
        "release_signed_at": { "type": "string", "format": "date-time" }
      }
    },
    "usage_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "context": { "type": "string", "description": "where + when used" },
          "used_by": { "type": "string" },
          "used_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["staging", "approved", "published", "deprecated", "archived"]
    }
  }
}
