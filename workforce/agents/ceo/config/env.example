# ACME Bonsai CEO Team (Apex) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_STRATEGY=channel_id_for_ceo_strategy
DISCORD_CHANNEL_DECISIONS=channel_id_for_ceo_decisions
DISCORD_CHANNEL_MEMOS=channel_id_for_ceo_memos
DISCORD_CHANNEL_ALERTS=channel_id_for_ceo_alerts

# === Email (Envoy outbound) ===
EMAIL_PROVIDER=postmark   # or "ses" or "resend"
EMAIL_PROVIDER_API_KEY=your_provider_api_key
EMAIL_FROM_ADDRESS=jane@acme-bonsai.example
EMAIL_REPLY_TO_ADDRESS=jane@acme-bonsai.example

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/ceo
CLAUDE_AGENT_ID=acme-ceo-apex

# === Database ===
CEO_LEDGER_DB_PATH=/path/to/workforce/agents/ceo/data/ceo-ledger.db

# === Cross-team ledger root (Compass read-only) ===
WORKSPACE_ROOT=/path/to/workforce/agents

# === Stakeholder address book ===
STAKEHOLDER_RECORDS_PATH=/path/to/workforce/agents/ceo/data/stakeholder-records.jsonl

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/ceo/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
