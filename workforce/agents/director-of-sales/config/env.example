# ACME Bonsai Director of Sales Team (Cash) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_sales_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_sales_approvals
DISCORD_CHANNEL_PIPELINE=channel_id_for_sales_pipeline
DISCORD_CHANNEL_ALERTS=channel_id_for_sales_alerts

# === Email + SMS ===
EMAIL_PROVIDER=postmark   # or "ses" or "resend"
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key
EMAIL_FROM_ADDRESS=sales@acme-bonsai.example

SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=your_sms_provider_api_key
SMS_FROM_NUMBER=+18435551234

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/director-of-sales
CLAUDE_AGENT_ID=acme-director-of-sales-cash

# === Database ===
SALES_LEDGER_DB_PATH=/path/to/workforce/agents/director-of-sales/data/sales-ledger.db

# === Cross-team handoffs ===
CONTRACT_COORDINATOR_HANDOFF_DIR=/path/to/workforce/agents/contract-coordinator/data/inbox
COO_INVENTORY_SHEET_ID=your_google_sheet_id_for_inventory
COO_CEDAR_SCHEDULING_CALENDAR=ops@acme-bonsai.example

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/director-of-sales/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
