# ACME Bonsai CTO Team (Allen) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_DRAFTS=channel_id_for_tech_drafts
DISCORD_CHANNEL_APPROVALS=channel_id_for_tech_approvals
DISCORD_CHANNEL_RELEASES=channel_id_for_tech_releases
DISCORD_CHANNEL_ALERTS=channel_id_for_tech_alerts

# === GitHub ===
GITHUB_TOKEN=your_github_pat_with_repo_scope
GITHUB_PRIMARY_REPO=your-org/storefront
GITHUB_WORKSPACE_REPO=your-org/lobster-jobsters

# === Hosting (Vercel) ===
VERCEL_TOKEN=your_vercel_api_token
VERCEL_PROJECT_ID=your_project_id
VERCEL_TEAM_ID=your_team_id

# === Cloudflare ===
CLOUDFLARE_API_KEY=your_cloudflare_api_key
CLOUDFLARE_ZONE_ID=your_zone_id

# === Database ===
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Read replica URL if applicable
DATABASE_READ_URL=

# === Stripe (PCI compliance via tokenization) ===
STRIPE_SECRET_KEY=sk_live_or_test_key
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# === Sentry ===
SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# === Better Uptime ===
BETTER_UPTIME_API_KEY=your_better_uptime_api_key

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/cto
CLAUDE_AGENT_ID=acme-cto-allen

# === Tech Ledger ===
TECH_LEDGER_DB_PATH=/path/to/workforce/agents/cto/data/tech-ledger.db

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/cto/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
