# ACME Bonsai Customer Service Manager Team (Poppy) — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_TICKETS=channel_id_for_care_tickets
DISCORD_CHANNEL_APPROVALS=channel_id_for_care_approvals
DISCORD_CHANNEL_RESOLUTIONS=channel_id_for_care_resolutions
DISCORD_CHANNEL_ALERTS=channel_id_for_care_alerts

# === Email + SMS ===
EMAIL_PROVIDER=postmark
EMAIL_PROVIDER_API_KEY=your_email_provider_api_key
EMAIL_FROM_ADDRESS=care@acme-bonsai.example

SMS_PROVIDER=twilio
SMS_PROVIDER_API_KEY=your_sms_provider_api_key
SMS_FROM_NUMBER=+18435551234

# === Stripe (refund execution via Sterling's flow) ===
STRIPE_SECRET_KEY=sk_live_or_test_key

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/customer-service-manager
CLAUDE_AGENT_ID=acme-csm-poppy

# === Database ===
CARE_LEDGER_DB_PATH=/path/to/workforce/agents/customer-service-manager/data/care-ledger.db

# === Cross-team ledger paths (read-only) ===
SALES_LEDGER_DB_PATH=/path/to/workforce/agents/director-of-sales/data/sales-ledger.db
OPS_LEDGER_DB_PATH=/path/to/workforce/agents/coo/data/ops-ledger.db
CONTRACT_LEDGER_DB_PATH=/path/to/workforce/agents/contract-coordinator/data/contract-ledger.db
FINANCE_LEDGER_DB_PATH=/path/to/workforce/agents/cfo/data/finance-ledger.db
CARE_GUIDES_PATH=/path/to/workforce/agents/creative-director/data/asset-library

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/customer-service-manager/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
