{
  "discord": {
    "guild_id": "YOUR_DISCORD_SERVER_ID",
    "channels": {
      "acme_care_tickets": {
        "id": "CHANNEL_ID_TICKETS",
        "name": "#acme-care-tickets",
        "purpose": "Ticket intake, daily triage, sub-agent coordination, status updates",
        "agents_that_post": ["customer-service-manager", "workspace-support", "order-management", "care-education"],
        "human_actions": ["review", "comment", "directive"]
      },
      "acme_care_approvals": {
        "id": "CHANNEL_ID_APPROVALS",
        "name": "#acme-care-approvals",
        "purpose": "CEO escalations: > $500 refunds, legal, rental > $300, major saves, patterns",
        "agents_that_post": ["customer-service-manager"],
        "human_actions": ["approve", "edit", "hold", "reject"]
      },
      "acme_care_resolutions": {
        "id": "CHANNEL_ID_RESOLUTIONS",
        "name": "#acme-care-resolutions",
        "purpose": "Resolved closures, customer thank-yous, success stories",
        "agents_that_post": ["customer-service-manager", "workspace-support", "order-management", "care-education"],
        "human_actions": ["read", "share_with_team"]
      },
      "acme_care_alerts": {
        "id": "CHANNEL_ID_ALERTS",
        "name": "#acme-care-alerts",
        "purpose": "Legal language detected, viral risk, pattern issues, high-value at-risk",
        "agents_that_post": ["customer-service-manager", "workspace-support", "order-management", "care-education"],
        "human_actions": ["acknowledge", "investigate", "resolve"]
      }
    },
    "approvers": {
      "ceo": {
        "discord_user_id": "CEO_DISCORD_ID",
        "name": "Jane (CEO)",
        "can_approve": [
          "approve_refund_large",
          "approve_rental_damage_dispute_large",
          "approve_major_account_save",
          "approve_subscription_cancellation_save",
          "approve_legal_response",
          "approve_pattern_issue_response",
          "emergency_stop"
        ],
        "notification_preference": "mention"
      },
      "csm": {
        "discord_user_id": "CSM_AGENT_ID",
        "name": "Poppy (CSM)",
        "can_approve": [
          "approve_refund_small",
          "approve_replacement_tree",
          "approve_store_credit_or_waiver",
          "approve_subscription_cancellation_save",
          "emergency_stop"
        ],
        "notification_preference": "mention"
      }
    },
    "notification_rules": {
      "approval_timeout_hours": 12,
      "escalation_timeout_hours": 24,
      "critical_incident_mention": "@here",
      "emergency_stop_mention": "@everyone"
    }
  }
}
