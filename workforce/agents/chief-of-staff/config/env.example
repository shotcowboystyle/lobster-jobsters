# ACME Bonsai Chief of Staff Team — Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env to version control.

# === Discord ===
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_CHANNEL_BRIEFINGS=channel_id_for_exec_briefings
DISCORD_CHANNEL_ACTIONS=channel_id_for_exec_actions
DISCORD_CHANNEL_INITIATIVES=channel_id_for_exec_initiatives
DISCORD_CHANNEL_ALERTS=channel_id_for_exec_alerts

# === Google Calendar (read-only) ===
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your_oauth_refresh_token
GOOGLE_CALENDAR_PRIMARY_ID=jane@example.com

# === GitHub (optional, for action-item tracking) ===
GITHUB_TOKEN=your_github_pat
GITHUB_ACTION_REPO=your-org/storefront

# === Claude Desktop ===
CLAUDE_PROJECT_DIR=/path/to/workforce/agents/chief-of-staff
CLAUDE_AGENT_ID=acme-chief-of-staff

# === Database ===
EXEC_LEDGER_DB_PATH=/path/to/workforce/agents/chief-of-staff/data/exec-ledger.db

# === Monitored workspace root (Magpie) ===
MONITORED_WORKSPACE_ROOT=/path/to/workforce/agents

# === Emergency Stop ===
EMERGENCY_STOP_FILE=/path/to/workforce/agents/chief-of-staff/config/emergency-stop.json

# === Timezone ===
TZ=America/New_York
